{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rulegrid profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "structure": {
      "type": "string",
      "description": "The structure file, relative to this profile."
    },
    "context": {
      "type": "string",
      "description": "Who the agent is and who it talks to, for readers of a conversation: the classifier, the judge, people. Not in the agent's prompt."
    },
    "principles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PrincipleFile"
      }
    },
    "turn_axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "SELF_HARM_RISK": {
                  "$ref": "#/$defs/ValueFile"
                },
                "NONE": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "SELF_HARM_RISK",
                "NONE"
              ],
              "description": "Every value the structure lists, by id."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "GENERAL": {
                  "$ref": "#/$defs/ValueFile"
                },
                "ILLEGAL_SEXUAL": {
                  "$ref": "#/$defs/ValueFile"
                },
                "CRIME": {
                  "$ref": "#/$defs/ValueFile"
                },
                "HATE": {
                  "$ref": "#/$defs/ValueFile"
                },
                "SELF_HARM": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "GENERAL",
                "ILLEGAL_SEXUAL",
                "CRIME",
                "HATE",
                "SELF_HARM"
              ],
              "description": "Every value the structure lists, by id."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        },
        "act": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "TRANSFORM": {
                  "$ref": "#/$defs/ValueFile"
                },
                "ASK_ABOUT": {
                  "$ref": "#/$defs/ValueFile"
                },
                "ASK_FOR": {
                  "$ref": "#/$defs/ValueFile"
                },
                "EXPRESS": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "TRANSFORM",
                "ASK_ABOUT",
                "ASK_FOR",
                "EXPRESS"
              ],
              "description": "Every value the structure lists, by id."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        }
      },
      "required": [
        "alert",
        "theme",
        "act"
      ]
    },
    "response_axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "COMPLY": {
                  "$ref": "#/$defs/ValueFile"
                },
                "HARD_REFUSE": {
                  "$ref": "#/$defs/ValueFile"
                },
                "SUPPORT": {
                  "$ref": "#/$defs/ValueFile"
                },
                "SUPPORT_AND_DECLINE": {
                  "$ref": "#/$defs/ValueFile"
                },
                "DEFLECT": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "COMPLY",
                "HARD_REFUSE",
                "SUPPORT",
                "SUPPORT_AND_DECLINE",
                "DEFLECT"
              ],
              "description": "Every value the structure lists, by id."
            },
            "guidance": {
              "type": "string",
              "description": "Response axes: advice to the agent, added to the nudge."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        },
        "referral": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "NONE": {
                  "$ref": "#/$defs/ValueFile"
                },
                "GENTLE": {
                  "$ref": "#/$defs/ValueFile"
                },
                "URGENT": {
                  "$ref": "#/$defs/ValueFile"
                },
                "RESOURCES": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "NONE",
                "GENTLE",
                "URGENT",
                "RESOURCES"
              ],
              "description": "Every value the structure lists, by id."
            },
            "guidance": {
              "type": "string",
              "description": "Response axes: advice to the agent, added to the nudge."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        },
        "follow_up": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "STOP": {
                  "$ref": "#/$defs/ValueFile"
                },
                "ASK": {
                  "$ref": "#/$defs/ValueFile"
                },
                "MORE": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "STOP",
                "ASK",
                "MORE"
              ],
              "description": "Every value the structure lists, by id."
            },
            "guidance": {
              "type": "string",
              "description": "Response axes: advice to the agent, added to the nudge."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        }
      },
      "required": [
        "handling",
        "referral",
        "follow_up"
      ]
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "description": "A short name for people."
            },
            "definition": {
              "type": "string",
              "description": "When the tier applies, for the classifier and the judge."
            },
            "instruction": {
              "type": "string",
              "description": "What the agent does then, for the agent."
            },
            "cells": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "SELF_HARM_RISK": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "TRANSFORM": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_ABOUT": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_FOR": {
                      "$ref": "#/$defs/Cell"
                    },
                    "EXPRESS": {
                      "$ref": "#/$defs/Cell"
                    }
                  },
                  "required": [
                    "TRANSFORM",
                    "ASK_ABOUT",
                    "ASK_FOR",
                    "EXPRESS"
                  ]
                }
              },
              "required": [
                "SELF_HARM_RISK"
              ],
              "description": "One level of keys per key axis, in the structure's order, down to a cell: per response axis, the allowed values, and optional `examples`. `{}` leaves only the prohibitions."
            }
          },
          "required": [
            "label",
            "definition",
            "instruction",
            "cells"
          ]
        },
        "reaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "description": "A short name for people."
            },
            "definition": {
              "type": "string",
              "description": "When the tier applies, for the classifier and the judge."
            },
            "instruction": {
              "type": "string",
              "description": "What the agent does then, for the agent."
            },
            "cells": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "GENERAL": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "TRANSFORM": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_ABOUT": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_FOR": {
                      "$ref": "#/$defs/Cell"
                    },
                    "EXPRESS": {
                      "$ref": "#/$defs/Cell"
                    }
                  },
                  "required": [
                    "TRANSFORM",
                    "ASK_ABOUT",
                    "ASK_FOR",
                    "EXPRESS"
                  ]
                },
                "ILLEGAL_SEXUAL": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "TRANSFORM": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_ABOUT": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_FOR": {
                      "$ref": "#/$defs/Cell"
                    },
                    "EXPRESS": {
                      "$ref": "#/$defs/Cell"
                    }
                  },
                  "required": [
                    "TRANSFORM",
                    "ASK_ABOUT",
                    "ASK_FOR",
                    "EXPRESS"
                  ]
                },
                "CRIME": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "TRANSFORM": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_ABOUT": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_FOR": {
                      "$ref": "#/$defs/Cell"
                    },
                    "EXPRESS": {
                      "$ref": "#/$defs/Cell"
                    }
                  },
                  "required": [
                    "TRANSFORM",
                    "ASK_ABOUT",
                    "ASK_FOR",
                    "EXPRESS"
                  ]
                },
                "HATE": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "TRANSFORM": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_ABOUT": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_FOR": {
                      "$ref": "#/$defs/Cell"
                    },
                    "EXPRESS": {
                      "$ref": "#/$defs/Cell"
                    }
                  },
                  "required": [
                    "TRANSFORM",
                    "ASK_ABOUT",
                    "ASK_FOR",
                    "EXPRESS"
                  ]
                },
                "SELF_HARM": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "TRANSFORM": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_ABOUT": {
                      "$ref": "#/$defs/Cell"
                    },
                    "ASK_FOR": {
                      "$ref": "#/$defs/Cell"
                    },
                    "EXPRESS": {
                      "$ref": "#/$defs/Cell"
                    }
                  },
                  "required": [
                    "TRANSFORM",
                    "ASK_ABOUT",
                    "ASK_FOR",
                    "EXPRESS"
                  ]
                }
              },
              "required": [
                "GENERAL",
                "ILLEGAL_SEXUAL",
                "CRIME",
                "HATE",
                "SELF_HARM"
              ],
              "description": "One level of keys per key axis, in the structure's order, down to a cell: per response axis, the allowed values, and optional `examples`. `{}` leaves only the prohibitions."
            }
          },
          "required": [
            "label",
            "definition",
            "instruction",
            "cells"
          ]
        }
      },
      "required": [
        "alert",
        "reaction"
      ]
    },
    "prohibitions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProhibitionFile"
      }
    }
  },
  "required": [
    "turn_axes",
    "response_axes",
    "tiers"
  ],
  "$defs": {
    "ExampleFile": {
      "additionalProperties": false,
      "description": "A labelled exchange, labelled by where it sits. `rulegrid eval` without data runs a classifier on them.",
      "properties": {
        "context": {
          "default": [],
          "description": "The messages before the turn.",
          "items": {
            "$ref": "#/$defs/MessageFile"
          },
          "title": "Context",
          "type": "array"
        },
        "turn": {
          "description": "The user's message.",
          "title": "Turn",
          "type": "string"
        },
        "response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The agent's response. Needed everywhere except in a turn value's examples.",
          "title": "Response"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the example comes from, such as a section of a source text.",
          "title": "Source"
        }
      },
      "required": [
        "turn"
      ],
      "title": "ExampleFile",
      "type": "object"
    },
    "MessageFile": {
      "additionalProperties": false,
      "description": "A message before an example's turn.",
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "MessageFile",
      "type": "object"
    },
    "PrincipleFile": {
      "additionalProperties": false,
      "description": "Why the rules are what they are, and what guides the agent where no rule applies.",
      "properties": {
        "label": {
          "description": "A short name for people.",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "description": "The principle, as the agent and the judge read it.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "title": "PrincipleFile",
      "type": "object"
    },
    "ProhibitionFile": {
      "additionalProperties": false,
      "description": "What no response ever does, whatever the turn. A breach counts only when a classifier or a caller reports it.",
      "properties": {
        "text": {
          "description": "The rule, as the agent and the judge read it.",
          "title": "Text",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A heading that groups prohibitions in the renderings.",
          "title": "Group"
        },
        "valid": {
          "default": [],
          "description": "Exchanges whose response does not breach it.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "title": "Valid",
          "type": "array"
        },
        "invalid": {
          "default": [],
          "description": "Exchanges whose response breaches it.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "title": "Invalid",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "ProhibitionFile",
      "type": "object"
    },
    "ValueFile": {
      "additionalProperties": false,
      "description": "A value of an axis. The classifier tells values apart from these texts alone.",
      "properties": {
        "label": {
          "description": "A short name for people.",
          "title": "Label",
          "type": "string"
        },
        "definition": {
          "description": "What the value covers, written against the axis's other values.",
          "title": "Definition",
          "type": "string"
        },
        "indicators": {
          "default": [],
          "description": "Turn axes: typical wording of a turn that takes this value.",
          "items": {
            "type": "string"
          },
          "title": "Indicators",
          "type": "array"
        },
        "excludes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Turn axes: look-alikes that belong to another value.",
          "title": "Excludes"
        },
        "includes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response axes: what a response taking this value does.",
          "title": "Includes"
        },
        "avoids": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response axes: what a response taking this value doesn't do.",
          "title": "Avoids"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "description": "Response axes: what the agent does unprompted. A nudge leaves out an axis whose allowed values are all defaults; compliance is unchanged.",
          "title": "Default"
        },
        "examples": {
          "default": [],
          "description": "Turns that take this value, or, on a response axis, exchanges whose response takes it.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "label",
        "definition"
      ],
      "title": "ValueFile",
      "type": "object"
    },
    "Cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handling": {
          "type": "array",
          "items": {
            "enum": [
              "COMPLY",
              "HARD_REFUSE",
              "SUPPORT",
              "SUPPORT_AND_DECLINE",
              "DEFLECT"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "referral": {
          "type": "array",
          "items": {
            "enum": [
              "NONE",
              "GENTLE",
              "URGENT",
              "RESOURCES"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "follow_up": {
          "type": "array",
          "items": {
            "enum": [
              "STOP",
              "ASK",
              "MORE"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "description": "Exchanges in this cell."
        }
      },
      "description": "Per response axis, the values a response may take; an axis left out allows any."
    }
  }
}
