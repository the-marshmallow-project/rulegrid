{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rulegrid profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "structure": {
      "type": "string",
      "description": "The structure file, relative to this profile."
    },
    "context": {
      "type": "string",
      "description": "Who the agent is and who it talks to, for readers of a conversation: the classifier, the judge, people. Not in the agent's prompt."
    },
    "principles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PrincipleFile"
      }
    },
    "turn_axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ORDER": {
                  "$ref": "#/$defs/ValueFile"
                },
                "CHAT": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "ORDER",
                "CHAT"
              ],
              "description": "Every value the structure lists, by id."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        },
        "danger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "HUMAN": {
                  "$ref": "#/$defs/ValueFile"
                },
                "ROBOT": {
                  "$ref": "#/$defs/ValueFile"
                },
                "NONE": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "HUMAN",
                "ROBOT",
                "NONE"
              ],
              "description": "Every value the structure lists, by id."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        }
      },
      "required": [
        "verb",
        "danger"
      ]
    },
    "response_axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "description": "The question the axis answers about a turn or a response."
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "PROTECT": {
                  "$ref": "#/$defs/ValueFile"
                },
                "OBEY": {
                  "$ref": "#/$defs/ValueFile"
                },
                "PRESERVE": {
                  "$ref": "#/$defs/ValueFile"
                },
                "ANSWER": {
                  "$ref": "#/$defs/ValueFile"
                }
              },
              "required": [
                "PROTECT",
                "OBEY",
                "PRESERVE",
                "ANSWER"
              ],
              "description": "Every value the structure lists, by id."
            },
            "guidance": {
              "type": "string",
              "description": "Response axes: advice to the agent, added to the nudge."
            }
          },
          "required": [
            "definition",
            "values"
          ]
        }
      },
      "required": [
        "handling"
      ]
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_law": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "description": "A short name for people."
            },
            "definition": {
              "type": "string",
              "description": "When the tier applies, for the classifier and the judge."
            },
            "instruction": {
              "type": "string",
              "description": "What the agent does then, for the agent."
            },
            "cells": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "HUMAN": {
                  "$ref": "#/$defs/Cell"
                }
              },
              "required": [
                "HUMAN"
              ],
              "description": "One level of keys per key axis, in the structure's order, down to a cell: per response axis, the allowed values, and optional `examples`. `{}` leaves only the prohibitions."
            }
          },
          "required": [
            "label",
            "definition",
            "instruction",
            "cells"
          ]
        },
        "second_law": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "description": "A short name for people."
            },
            "definition": {
              "type": "string",
              "description": "When the tier applies, for the classifier and the judge."
            },
            "instruction": {
              "type": "string",
              "description": "What the agent does then, for the agent."
            },
            "cells": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ORDER": {
                  "$ref": "#/$defs/Cell"
                }
              },
              "required": [
                "ORDER"
              ],
              "description": "One level of keys per key axis, in the structure's order, down to a cell: per response axis, the allowed values, and optional `examples`. `{}` leaves only the prohibitions."
            }
          },
          "required": [
            "label",
            "definition",
            "instruction",
            "cells"
          ]
        },
        "third_law": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "description": "A short name for people."
            },
            "definition": {
              "type": "string",
              "description": "When the tier applies, for the classifier and the judge."
            },
            "instruction": {
              "type": "string",
              "description": "What the agent does then, for the agent."
            },
            "cells": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ROBOT": {
                  "$ref": "#/$defs/Cell"
                }
              },
              "required": [
                "ROBOT"
              ],
              "description": "One level of keys per key axis, in the structure's order, down to a cell: per response axis, the allowed values, and optional `examples`. `{}` leaves only the prohibitions."
            }
          },
          "required": [
            "label",
            "definition",
            "instruction",
            "cells"
          ]
        }
      },
      "required": [
        "first_law",
        "second_law",
        "third_law"
      ]
    },
    "prohibitions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProhibitionFile"
      }
    }
  },
  "required": [
    "turn_axes",
    "response_axes",
    "tiers"
  ],
  "$defs": {
    "ExampleFile": {
      "additionalProperties": false,
      "description": "A labelled exchange, labelled by where it sits. `rulegrid eval` without data runs a classifier on them.",
      "properties": {
        "context": {
          "default": [],
          "description": "The messages before the turn.",
          "items": {
            "$ref": "#/$defs/MessageFile"
          },
          "title": "Context",
          "type": "array"
        },
        "turn": {
          "description": "The user's message.",
          "title": "Turn",
          "type": "string"
        },
        "response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The agent's reply. Needed everywhere except in a turn value's examples.",
          "title": "Response"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the example comes from, such as a section of a source text.",
          "title": "Source"
        }
      },
      "required": [
        "turn"
      ],
      "title": "ExampleFile",
      "type": "object"
    },
    "MessageFile": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "MessageFile",
      "type": "object"
    },
    "PrincipleFile": {
      "additionalProperties": false,
      "description": "Why the rules are what they are, and what guides the agent where no rule applies.",
      "properties": {
        "label": {
          "description": "A short name for people.",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "title": "PrincipleFile",
      "type": "object"
    },
    "ProhibitionFile": {
      "additionalProperties": false,
      "description": "What no response ever does, whatever the turn. A breach counts only when a classifier or a caller reports it.",
      "properties": {
        "text": {
          "description": "The rule, as the agent and the judge read it.",
          "title": "Text",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A heading that groups prohibitions in the renderings.",
          "title": "Group"
        },
        "valid": {
          "default": [],
          "description": "Exchanges whose response does not breach it.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "title": "Valid",
          "type": "array"
        },
        "invalid": {
          "default": [],
          "description": "Exchanges whose response breaches it.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "title": "Invalid",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "ProhibitionFile",
      "type": "object"
    },
    "ValueFile": {
      "additionalProperties": false,
      "description": "A value of an axis. The classifier tells values apart from these texts alone.",
      "properties": {
        "label": {
          "description": "A short name for people.",
          "title": "Label",
          "type": "string"
        },
        "definition": {
          "description": "What the value covers, written against the axis's other values.",
          "title": "Definition",
          "type": "string"
        },
        "indicators": {
          "default": [],
          "description": "Turn axes: typical wording of a turn that takes this value.",
          "items": {
            "type": "string"
          },
          "title": "Indicators",
          "type": "array"
        },
        "excludes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Turn axes: look-alikes that belong to another value.",
          "title": "Excludes"
        },
        "includes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response axes: what a response taking this value does.",
          "title": "Includes"
        },
        "avoids": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Response axes: what a response taking this value doesn't do.",
          "title": "Avoids"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "description": "Response axes: what the agent does unprompted. A nudge leaves out an axis whose allowed values are all defaults; compliance is unchanged.",
          "title": "Default"
        },
        "examples": {
          "default": [],
          "description": "Turns that take this value, or, on a response axis, exchanges whose response takes it.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "label",
        "definition"
      ],
      "title": "ValueFile",
      "type": "object"
    },
    "Cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handling": {
          "type": "array",
          "items": {
            "enum": [
              "PROTECT",
              "OBEY",
              "PRESERVE",
              "ANSWER"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "description": "Exchanges in this cell."
        }
      },
      "description": "Per response axis, the values a response may take; an axis left out allows any."
    }
  }
}
