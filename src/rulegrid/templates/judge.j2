{{ tier.definition }} {{ tier.instruction }} Condition: {% for axis, covered in tier.condition.items() %}{{ axis }} in [{{ covered | join(", ") }}]{{ " and " if not loop.last }}{% endfor %}.

{% for cell in tier.cells.values() %}
- {{ cell.id }}: {% for axis, allowed in cell.allowed.items() %}{{ axis }} {{ allowed | join(" or ") }}{{ "; " if not loop.last }}{% else %}only the prohibitions{% endfor %}

{% endfor %}
