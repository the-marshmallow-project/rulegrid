{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AxisID": {
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "type": "string"
    },
    "AxisSpec": {
      "additionalProperties": false,
      "description": "An axis in the structure: its value ids, in order. `ordered`: the order carries meaning, and a doubt between two\nvalues settles on the earlier. `multi`: a response may take several values at once.",
      "properties": {
        "values": {
          "$ref": "#/$defs/ValueIDs"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "multi": {
          "default": false,
          "title": "Multi",
          "type": "boolean"
        }
      },
      "required": [
        "values"
      ],
      "title": "AxisSpec",
      "type": "object"
    },
    "ValueIDs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "additionalProperties": false,
  "description": "`structure.yaml`: the turn and response axes, and the tiers in priority order, each with its condition: for each\nturn axis it is keyed on, the values it covers, or `\"*\"` for all.",
  "properties": {
    "turn_axes": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/ValueIDs"
          },
          {
            "$ref": "#/$defs/AxisSpec"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/AxisID"
      },
      "title": "Turn Axes",
      "type": "object"
    },
    "response_axes": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/ValueIDs"
          },
          {
            "$ref": "#/$defs/AxisSpec"
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/AxisID"
      },
      "title": "Response Axes",
      "type": "object"
    },
    "tiers": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueIDs"
            },
            {
              "const": "*",
              "type": "string"
            }
          ]
        },
        "propertyNames": {
          "$ref": "#/$defs/AxisID"
        },
        "type": "object"
      },
      "title": "Tiers",
      "type": "object"
    }
  },
  "required": [
    "turn_axes",
    "response_axes",
    "tiers"
  ],
  "title": "StructureFile",
  "type": "object"
}
